# Copiez vers .env puis adaptez. Les scripts lisent ces variables d'environnement.
# Le serveur web écoute 127.0.0.1 par défaut. Pour un conteneur :
#   QEYNOX_BIND=0.0.0.0 et QEYNOX_API_TOKEN obligatoire (le processus refuse sinon).
QEYNOX_BIND=127.0.0.1
GTM_WEB_PORT=8765
QEYNOX_API_TOKEN=
SEARXNG_URL=http://127.0.0.1:8888
GTM_DB=data/gtm.db
GTM_LANG=fr
GTM_GL=FR          # pays pour autocomplete/tendances (FR, BE, CA, MA…)
GTM_DOMAIN=        # domaine du produit (serp_rank) — sinon --domain
GTM_BRAND=         # nom de marque pour signaux / intent brand
GTM_BRAND_ALIASES= # aliases séparés par des virgules

# Hermes (worker V2 — RÉSERVÉ : aucun code BETA50 ne lit ces variables)
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=

# Mode démo / CI : recherches web déterministes (aucun appel réseau de recherche).
# QEYNOX_OFFLINE_SEARCH=1

# Contrat de livraison BETA50 : ../docs/beta50/BETA50_CONTRACT.md
