{
  "name": "@qeynox/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "qa:agent-runtime": "tsx scripts/qa-agent-runtime.ts",
    "qa:connectors": "tsx scripts/qa-connectors.ts",
    "qa:raas-deliverable": "tsx scripts/qa-raas-deliverable.ts",
    "qa:storage": "tsx scripts/qa-object-storage.ts",
    "qa:egress": "tsx scripts/qa-egress.ts"
  },
  "dependencies": {
    "@qeynox/application": "workspace:*",
    "@qeynox/domain": "workspace:*",
    "@qeynox/roles": "workspace:*",
    "@qeynox/orchestration": "workspace:*",
    "@qeynox/persistence": "workspace:*",
    "@qeynox/engine": "workspace:*",
    "@qeynox/tools": "workspace:*",
    "drizzle-orm": "0.44.5",
    "@hatchet-dev/typescript-sdk": "1.46.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "@aws-sdk/client-s3": "3.1166.0",
    "@aws-sdk/s3-request-presigner": "3.1166.0"
  }
}
