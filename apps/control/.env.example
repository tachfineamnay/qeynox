# Server-only origin of the QeyNox API (NestJS). Never exposed to the browser.
# The Control desk only uses /v1/platform/* with a platform bearer session; it never sends a
# workspace session or an X-Qeynox-Workspace header.
QEYNOX_PLATFORM_API_URL=http://127.0.0.1:4000
# Optional exact server-only private origin authorization for preproduction networks.
QEYNOX_PLATFORM_API_PRIVATE_ORIGIN=
