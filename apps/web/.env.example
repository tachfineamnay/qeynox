# Server-only origin for the existing NestJS API. Never use a NEXT_PUBLIC token.
QEYNOX_API_URL=http://127.0.0.1:4000
# Exact HTTP origin allowed for server-to-server calls on a trusted private network.
QEYNOX_API_PRIVATE_ORIGIN=

# Public SEO canonical origin (canonical/hreflang/sitemap). Existing qeynox.io routing unchanged.
QEYNOX_PUBLIC_URL=https://qeynox.io
# Public contact address shown on /contact only when verified and set.
QEYNOX_CONTACT_EMAIL=
