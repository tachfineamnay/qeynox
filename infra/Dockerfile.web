FROM node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS build
WORKDIR /workspace
ENV COREPACK_HOME=/opt/corepack
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch --frozen-lockfile
COPY . .
ARG QEYNOX_RELEASE_SHA
ARG QEYNOX_RELEASE_VERSION
ENV QEYNOX_RELEASE_SHA=$QEYNOX_RELEASE_SHA QEYNOX_RELEASE_VERSION=$QEYNOX_RELEASE_VERSION
RUN node infra/release/stamp.mjs
RUN pnpm install --offline --frozen-lockfile
RUN pnpm typecheck && pnpm build
# QA scripts and fixture screenshots must not be copied into the runtime image.
RUN rm -rf /workspace/docs/flow/evidence /workspace/apps/web/scripts /workspace/infra/tests \
 && find /workspace/apps/api /workspace/apps/worker -type f -name 'qa-*' -delete
FROM node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee
ARG QEYNOX_RELEASE_SHA
ARG QEYNOX_RELEASE_VERSION
ENV NODE_ENV=production QEYNOX_RELEASE_SHA=$QEYNOX_RELEASE_SHA QEYNOX_RELEASE_VERSION=$QEYNOX_RELEASE_VERSION
LABEL org.opencontainers.image.revision=$QEYNOX_RELEASE_SHA org.opencontainers.image.version=$QEYNOX_RELEASE_VERSION
STOPSIGNAL SIGTERM
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
ENV COREPACK_HOME=/opt/corepack
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
COPY --from=build --chown=node:node /workspace /workspace
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 CMD ["node", "/workspace/infra/release/health.mjs", "web"]
ENTRYPOINT ["sh", "/workspace/infra/release/entrypoint.sh", "web"]
