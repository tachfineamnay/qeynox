FROM node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS build
WORKDIR /workspace
ENV COREPACK_HOME=/opt/corepack
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch --frozen-lockfile
COPY . .
RUN pnpm install --offline --frozen-lockfile
RUN pnpm typecheck && pnpm build
FROM node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee
ENV NODE_ENV=production
# Hatchet SDK 1.46.1 provides /livez (process) and /readyz (listener).
ENV HATCHET_CLIENT_WORKER_HEALTHCHECK_ENABLED=true
ENV HATCHET_CLIENT_WORKER_HEALTHCHECK_PORT=8001
WORKDIR /workspace
ENV COREPACK_HOME=/opt/corepack
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
COPY --from=build --chown=node:node /workspace /workspace
USER node
EXPOSE 8001
# Liveness must not restart a worker solely because Hatchet temporarily disconnects.
# Operational readiness is GET http://127.0.0.1:8001/readyz, not this liveness probe.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s CMD node -e "fetch('http://127.0.0.1:8001/livez').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["pnpm", "--filter", "@qeynox/worker", "start"]
