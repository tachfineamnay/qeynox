# Hermes service ONLY / operator rendering environment. Never attach this to API/Worker/Web/Control.
# Actual secrets stay on the verified Coolify host, outside the repo; no JSON/keys in env values.
HERMES_API_KEY=
QEYNOX_HERMES_VERTEX_PROJECT=
QEYNOX_HERMES_VERTEX_REGION=global
# Exact operator-approved google/gemini-* ID, advertised as an explicit model route; no guessed default.
QEYNOX_HERMES_VERTEX_MODEL=
# Existing regular files on the VERIFIED DEPLOYMENT HOST (not this repository).
# Config: output of pnpm hermes:vertex-config, reviewed before a separately authorized rollout.
QEYNOX_HERMES_CONFIG_FILE=
# SA JSON readable by the image's actual Hermes UID/GID, mode 0400, never world-readable.
QEYNOX_VERTEX_CREDENTIAL_FILE=
