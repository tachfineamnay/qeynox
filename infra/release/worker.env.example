# Role-specific Coolify runtime contract; copy outside Git and fill real values in secret storage.
# Required values intentionally blank are blocking diagnostics, never product fallbacks.
# SHA/version must match the same immutable build arguments in all four applications.
NODE_ENV=production
QEYNOX_DEPLOYMENT_ENV=preproduction
QEYNOX_RELEASE_SHA=
QEYNOX_RELEASE_VERSION=
QEYNOX_COMMERCE_MODE=BETA_FREE
QEYNOX_REGISTRATION_MODE=INVITE_ONLY
DATABASE_URL=
QEYNOX_REDIS_URL=
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_API_URL=http://qeynox-hatchet:8888
HATCHET_CLIENT_HOST_PORT=qeynox-hatchet:7077
HATCHET_CLIENT_TLS_STRATEGY=none
HERMES_API_BASE_URL=http://qeynox-hermes:8642/v1/
HERMES_PRIVATE_ORIGIN=http://qeynox-hermes:8642
HERMES_API_KEY=
HERMES_MODEL=
QEYNOX_ARTIFACT_ENDPOINT=http://qeynox-storage:9000
QEYNOX_ARTIFACT_BUCKET=
QEYNOX_ARTIFACT_REGION=us-east-1
QEYNOX_ARTIFACT_ACCESS_KEY=
QEYNOX_ARTIFACT_SECRET_KEY=
QEYNOX_SERVICE_CATALOG_PATH=/workspace/infra/operator/a16-business-packs.json
QEYNOX_PUBLIC_URL=https://qeynox.io
QEYNOX_EMAIL_PROVIDER=resend
QEYNOX_RESEND_API_KEY=
QEYNOX_EMAIL_FROM=
HERMES_PROVIDER=vertex
HERMES_REQUEST_TIMEOUT_MS=60000
HERMES_NATIVE_TOOLS_ISOLATED=false
QEYNOX_NETWORK_POLICY_ATTESTED=false
QEYNOX_RUNTIME_PROBE_TIMEOUT_MS=5000
QEYNOX_RUNTIME_PROBE_FRESHNESS_SECONDS=120
QEYNOX_RUNTIME_PROBE_INTERVAL_SECONDS=30
QEYNOX_DOCUMENT_INGEST_INTERVAL_MS=5000
QEYNOX_DOCUMENT_INGEST_LEASE_MS=300000
QEYNOX_ARTIFACT_SERVER_SIDE_ENCRYPTION=AES256
QEYNOX_WORLD_BANK_ENABLED=false
QEYNOX_BRAVE_SEARCH_ENABLED=false
QEYNOX_BRAVE_SEARCH_API_KEY=
QEYNOX_EGRESS_ALLOWED_HOSTS=
QEYNOX_EMBEDDINGS_ENABLED=false
QEYNOX_EMBEDDINGS_ENDPOINT=
QEYNOX_EMBEDDINGS_MODEL=
QEYNOX_EMBEDDINGS_API_KEY=
QEYNOX_EMBEDDINGS_ALLOWED_HOSTS=

# Only needed when the reviewed private Hatchet endpoint uses client TLS.
HATCHET_CLIENT_TLS_CERT_FILE=
HATCHET_CLIENT_TLS_KEY_FILE=
HATCHET_CLIENT_TLS_ROOT_CA_FILE=
HATCHET_CLIENT_TLS_SERVER_NAME=

# Vertex routing hint + exact approved google/gemini-* route; credentials are mounted in Hermes ONLY.
# HERMES_MODEL intentionally blank above: model discovery is required, no generic alias fallback.
