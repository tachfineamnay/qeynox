# Date: 2026-10-03
# QeyNox preprod — EXAMPLE ONLY
# Never commit real values.

QEYNOX_ENV=preprod
QEYNOX_API_BASE_URL=https://api-preprod.example.com
QEYNOX_WEB_BASE_URL=https://preprod.example.com

# Business database
QEYNOX_DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/qeynox

# Hatchet
HATCHET_CLIENT_TOKEN=REPLACE_ME
HATCHET_TENANT_ID=REPLACE_ME
HATCHET_API_URL=http://hatchet:8080

# Object storage
S3_ENDPOINT=http://minio:9000
S3_BUCKET=qeynox-preprod
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=REPLACE_ME
LANGFUSE_SECRET_KEY=REPLACE_ME

# Policy
OPA_URL=http://opa:8181

# MCP / integrations
TOOLHIVE_URL=http://toolhive:8080
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=REPLACE_ME

# Optional providers
SEARXNG_URL=http://searxng:8080
OLLAMA_URL=http://ollama:11434
