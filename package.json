{
  "name": "qeynox",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @qeynox/web dev",
    "dev:control": "pnpm --filter @qeynox/control dev",
    "dev:api": "pnpm --filter @qeynox/api dev",
    "dev:worker": "pnpm --filter @qeynox/worker dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && pnpm typecheck:release",
    "qa:task02": "pnpm --filter @qeynox/api qa:task02",
    "qa:backend": "pnpm --filter @qeynox/api qa:backend",
    "qa:agent-runtime": "pnpm --filter @qeynox/worker qa:agent-runtime",
    "qa:connectors": "pnpm --filter @qeynox/worker qa:connectors",
    "qa:raas": "pnpm --filter @qeynox/worker qa:raas-deliverable",
    "qa:storage": "pnpm --filter @qeynox/worker qa:storage",
    "qa:egress": "pnpm --filter @qeynox/worker qa:egress",
    "qa:platform-authorization": "pnpm --filter @qeynox/api qa:platform-authorization",
    "qa:platform-admin": "pnpm --filter @qeynox/api qa:platform-admin",
    "qa:platform-users": "pnpm --filter @qeynox/api qa:platform-users",
    "qa:platform-organizations": "pnpm --filter @qeynox/api qa:platform-organizations",
    "qa:platform-configuration": "pnpm --filter @qeynox/api qa:platform-configuration",
    "qa:chatwoot": "pnpm --filter @qeynox/api qa:chatwoot",
    "qa:support-isolation": "pnpm --filter @qeynox/api qa:support-isolation",
    "qa:support-private": "pnpm --filter @qeynox/api qa:support-private",
    "qa:support-concurrency": "pnpm --filter @qeynox/api qa:support-concurrency",
    "qa:support-reconciliation": "pnpm --filter @qeynox/api qa:support-reconciliation",
    "admin:bootstrap": "pnpm --filter @qeynox/api admin:bootstrap",
    "qa:hermes-contract": "pnpm --filter @qeynox/engine qa:hermes-contract",
    "qa:hermes-live": "pnpm --filter @qeynox/worker qa:hermes-live",
    "qa:hermes-live-selftest": "pnpm --filter @qeynox/worker qa:hermes-live-selftest",
    "hermes:diagnose": "pnpm --filter @qeynox/worker hermes:diagnose",
    "qa:runtime-readiness": "pnpm --filter @qeynox/application qa:runtime-readiness",
    "qa:runtime-verification": "pnpm --filter @qeynox/api qa:runtime-verification",
    "qa:a03-service": "pnpm --filter @qeynox/worker qa:a03-service",
    "qa:service-catalogue": "pnpm --filter @qeynox/worker qa:service-catalogue",
    "qa:connector-hub": "pnpm --filter @qeynox/worker qa:connector-hub",
    "qa:identity": "pnpm --filter @qeynox/api qa:identity",
    "qa:soul-intelligence": "pnpm --filter @qeynox/api qa:soul-intelligence",
    "qa:pilot-planner": "pnpm --filter @qeynox/api qa:pilot-planner",
    "qa:mission-lifecycle": "pnpm --filter @qeynox/worker qa:mission-lifecycle",
    "qa:atlas-results": "pnpm --filter @qeynox/worker qa:atlas-results",
    "qa:stripe-payments": "pnpm --filter @qeynox/worker qa:stripe-payments",
    "qa:payment-freeze": "pnpm --filter @qeynox/api qa:payment-freeze",
    "qa:beta-access": "pnpm --filter @qeynox/api qa:beta-access",
    "qa:beta-execution": "pnpm --filter @qeynox/api qa:beta-execution",
    "qa:verification-resend": "pnpm --filter @qeynox/api qa:verification-resend",
    "qa:registration": "pnpm --filter @qeynox/api qa:registration",
    "qa:beta-journey": "pnpm --filter @qeynox/api qa:beta-journey",
    "qa:brave-search": "pnpm --filter @qeynox/worker qa:brave-search",
    "qa:workspace-management": "pnpm --filter @qeynox/worker qa:workspace-management",
    "qa:documents": "pnpm --filter @qeynox/worker qa:documents",
    "qa:notifications": "pnpm --filter @qeynox/api qa:notifications",
    "qa:business-packs": "pnpm --filter @qeynox/api qa:business-packs",
    "qa:atlas-library": "pnpm --filter @qeynox/api qa:atlas-library",
    "qa:security-regressions": "pnpm --filter @qeynox/worker qa:security-regressions",
    "qa:hardening-followup": "pnpm --filter @qeynox/worker qa:hardening-followup",
    "qa:tool-authorization": "pnpm --filter @qeynox/worker qa:tool-authorization",
    "qa:worker-lifecycle": "pnpm --filter @qeynox/worker qa:worker-lifecycle",
    "db:release": "pnpm --filter @qeynox/persistence db:release",
    "release:inspect": "node infra/release/inspect-coolify.mjs",
    "release:render": "node infra/release/render.mjs",
    "release:check": "node infra/release/config-check.mjs",
    "release:verify": "tsx infra/release/verify.ts",
    "release:test": "tsx --test infra/release/release.test.ts",
    "typecheck:release": "tsc --noEmit -p infra/release/tsconfig.json",
    "hermes:vertex-config": "node infra/services/render-hermes-vertex.mjs",
    "qa:hermes-vertex-contract": "tsx --test packages/engine/scripts/qa-hermes-vertex-contract.test.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "turbo": "2.5.8",
    "@types/node": "22.15.30"
  }
}
