{
  "name": "qeynox",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @qeynox/web dev",
    "dev:api": "pnpm --filter @qeynox/api dev",
    "dev:worker": "pnpm --filter @qeynox/worker dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "qa:task02": "pnpm --filter @qeynox/api qa:task02",
    "qa:backend": "pnpm --filter @qeynox/api qa:backend",
    "qa:agent-runtime": "pnpm --filter @qeynox/worker qa:agent-runtime",
    "qa:connectors": "pnpm --filter @qeynox/worker qa:connectors",
    "qa:raas": "pnpm --filter @qeynox/worker qa:raas-deliverable",
    "qa:storage": "pnpm --filter @qeynox/worker qa:storage",
    "qa:egress": "pnpm --filter @qeynox/worker qa:egress"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "turbo": "2.5.8",
    "@types/node": "22.15.30"
  }
}
