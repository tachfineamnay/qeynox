# Never send local credentials, Git metadata or workstation dependencies into an image.
.git
.git/
.gitignore
**/.git/
**/node_modules/
node_modules/
**/dist/
**/.turbo/
**/coverage/
**/.next/
**/.cache/
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.pfx
*.sqlite
*.sqlite3
*.log
.DS_Store
.tmp/
.pnpm-store/
.cache/
.codex/
.agents/
.aws/
**/*.tsbuildinfo
# Local Web QA fixtures and screenshots are not inputs to container builds.
apps/web/scripts/
docs/flow/evidence/

# Generated inside the image from reviewed release build arguments.
.qeynox-release.json
