# Never send local credentials, Git metadata or workstation dependencies into an image.
.git
.git/
.gitignore
**/.git/
**/node_modules/
node_modules/
**/dist/
**/.turbo/
**/coverage/
**/.next/
**/.cache/
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.pfx
*.sqlite
*.sqlite3
*.log
.DS_Store
