# Copier vers .env (gitignored). Aucun secret réel dans ce fichier.
# Le conteneur écoute 0.0.0.0 : sans jeton, le processus refuse de démarrer.

QEYNOX_API_TOKEN=change-me

# Adresse d'écoute dans le conteneur. Ne pas remettre 127.0.0.1 derrière le proxy Coolify.
QEYNOX_BIND=0.0.0.0
GTM_WEB_PORT=8765

# Volume persistant monté sur /data (voir docker-compose.yml).
QEYNOX_STACKS_DIR=/data/stacks
QEYNOX_LOGS_DIR=/data/logs
QEYNOX_MISSIONS_FILE=/data/missions.json

# SearXNG optionnel (profil compose "search"). S'il est arrêté, la research
# retombe sur Bing/DDG et /api/health rapporte searxng=false.
SEARXNG_URL=http://searxng:8080

GTM_LANG=fr
GTM_GL=FR

# none | auto | ollama | openai. none évite tout appel LLM.
QEYNOX_LLM=none
# QEYNOX_LLM_MODEL=
# QEYNOX_OLLAMA_URL=http://127.0.0.1:11434
# QEYNOX_LLM_BASEURL=https://api.openai.com/v1
# QEYNOX_LLM_API_KEY=

# Ancien nom encore accepté en plus de QEYNOX_API_TOKEN.
# GTM_HOOK_TOKEN=

# Optionnel. PAT GitHub fine-grained en lecture seule (Contents: Read)
# pour cloner des dépôts privés. Utilisé seulement pour https://github.com/ .
# Le jeton n'est pas mis dans l'URL. Laisser vide pour les dépôts publics.
# QEYNOX_GIT_TOKEN=
