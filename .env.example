NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://qeynox_user:replace_me@postgres:5432/qeynox
QEYNOX_ALLOW_REGISTRATION=false
# Operator must configure real verification and gateway rate limits before accepting customers.
HATCHET_CLIENT_TOKEN=
HERMES_API_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
HERMES_NATIVE_TOOLS_ISOLATED=false
# Both Hermes attestations below are REQUIRED before tenant execution; flags alone are NOT security proof.
# Physically isolate Hermes native tools and network egress before setting them.
HERMES_REQUEST_TIMEOUT_MS=60000
QEYNOX_WORLD_BANK_ENABLED=false
# Provider egress: only documented HTTPS hosts may be called; the allowlist is not DNS-rebinding proof.
QEYNOX_EGRESS_ALLOWED_HOSTS=
QEYNOX_NETWORK_POLICY_ATTESTED=false
QEYNOX_ARTIFACT_BUCKET=
QEYNOX_ARTIFACT_REGION=us-east-1
QEYNOX_ARTIFACT_ENDPOINT=
QEYNOX_ARTIFACT_ACCESS_KEY=
QEYNOX_ARTIFACT_SECRET_KEY=
# SSE-S3 is required by default; set to false only for a private S3-compatible QA store without KMS.
QEYNOX_ARTIFACT_SERVER_SIDE_ENCRYPTION=AES256
#
QEYNOX_CONNECTOR_TIMEOUT_MS=15000
# Comma-separated identity user IDs allowed to control global product configuration
# (capabilities, profiles, Soul, Pilot, tools, verification policies, offers and budget policies).
# Unset means the operator configuration API fails closed with NOT_CONFIGURED.
QEYNOX_OPERATOR_USER_IDS=
# The migration CLI refuses to run unless this is explicitly true, never with NODE_ENV=production.
# Enforcement target is a disposable/QA database only.
QEYNOX_ALLOW_MIGRATIONS=false
#
# Global platform administration (internal QeyNox roles: PLATFORM_ADMIN, SUPPORT, OPERATIONS,
# AUDITOR). These are NOT workspace roles: OWNER/ADMIN/MEMBER never grant platform access and a
# platform session never selects a workspace. There is no web self-service assignment; the first
# administrator is granted only by the explicit CLI below, which also requires --confirm.
#   QEYNOX_PLATFORM_BOOTSTRAP_ALLOW=true pnpm admin:bootstrap -- \
#     --email operator@example.com --role PLATFORM_ADMIN --confirm --reason "initial operator"
# When the identity account must be created, provide QEYNOX_BOOTSTRAP_PASSWORD (12-256 chars);
# it is read once and never logged or stored in clear text.
QEYNOX_PLATFORM_BOOTSTRAP_ALLOW=false



# Server-only exact origin authorizations, never browser input.
QEYNOX_API_PRIVATE_ORIGIN=
HERMES_PRIVATE_ORIGIN=
QEYNOX_REDIS_URL=
