NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://qeynox_user:replace_me@postgres:5432/qeynox
# MISSION A21.05 — the ONE authoritative registration policy (API-enforced; the web register page renders
# only what GET /v1/auth/registration-policy reports, it has no switch of its own).
#   CLOSED      (default; also unset/blank) — no signup.
#   INVITE_ONLY — signup requires an operator-issued registration invitation bound to the e-mail; it
#                 creates the account, the workspace and an ACTIVE beta grant atomically. Use for the beta.
#   OPEN        — anyone may sign up; an uninvited workspace is NOT enrolled in the beta (cannot launch).
# Any other value fails closed (CLOSED). The legacy QEYNOX_ALLOW_REGISTRATION=true is still read as OPEN
# ONLY when QEYNOX_REGISTRATION_MODE is unset (deprecated). QEYNOX_REGISTRATION_ENABLED is no longer read.
QEYNOX_REGISTRATION_MODE=CLOSED
# Operator must configure real verification and gateway rate limits before accepting customers.
HATCHET_CLIENT_TOKEN=
HERMES_API_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
HERMES_NATIVE_TOOLS_ISOLATED=false
# Both Hermes attestations below are REQUIRED before tenant execution; flags alone are NOT security proof.
# Physically isolate Hermes native tools and network egress before setting them.
HERMES_REQUEST_TIMEOUT_MS=60000
QEYNOX_WORLD_BANK_ENABLED=false
# Licensed web search (Brave Search API). Triple-gated like every reviewed provider: ACTIVE
# tool configuration + this switch + attested egress allowlisting api.search.brave.com. The
# subscription token is sent only as an X-Subscription-Token header from the server; never expose
# it to the browser, prompts or logs. Without a token the connector does not exist here.
QEYNOX_BRAVE_SEARCH_ENABLED=false
QEYNOX_BRAVE_SEARCH_API_KEY=
# Provider egress: only documented HTTPS hosts may be called; the allowlist is not DNS-rebinding proof.
QEYNOX_EGRESS_ALLOWED_HOSTS=
QEYNOX_NETWORK_POLICY_ATTESTED=false
QEYNOX_ARTIFACT_BUCKET=
QEYNOX_ARTIFACT_REGION=us-east-1
QEYNOX_ARTIFACT_ENDPOINT=
QEYNOX_ARTIFACT_ACCESS_KEY=
QEYNOX_ARTIFACT_SECRET_KEY=
# SSE-S3 is required by default; set to false only for a private S3-compatible QA store without KMS.
QEYNOX_ARTIFACT_SERVER_SIDE_ENCRYPTION=AES256
# MISSION A17 — optional document-ingest poller on the worker (milliseconds; 0 disables; API also
# drains same-process best-effort after /complete). The durable document_ingest_jobs table is the
# real guarantee; missing object storage leaves ingestion fail-closed.
QEYNOX_DOCUMENT_INGEST_INTERVAL_MS=5000
# Optional reviewed embeddings for hybrid retrieval (OpenAI-compatible, HTTPS only, attested egress,
# host allowlist). Unset ⇒ document search runs on PostgreSQL full-text search only.
QEYNOX_EMBEDDINGS_ENABLED=false
QEYNOX_EMBEDDINGS_ENDPOINT=
QEYNOX_EMBEDDINGS_API_KEY=
QEYNOX_EMBEDDINGS_MODEL=
QEYNOX_EMBEDDINGS_ALLOWED_HOSTS=
#
QEYNOX_CONNECTOR_TIMEOUT_MS=15000
# Comma-separated identity user IDs allowed to control global product configuration
# (capabilities, profiles, Soul, Pilot, tools, verification policies, offers and budget policies).
# Unset means the operator configuration API fails closed with NOT_CONFIGURED.
QEYNOX_OPERATOR_USER_IDS=
# The migration CLI refuses to run unless this is explicitly true, never with NODE_ENV=production.
# Enforcement target is a disposable/QA database only.
QEYNOX_ALLOW_MIGRATIONS=false
#
# Global platform administration (internal QeyNox roles: PLATFORM_ADMIN, SUPPORT, OPERATIONS,
# AUDITOR). These are NOT workspace roles: OWNER/ADMIN/MEMBER never grant platform access and a
# platform session never selects a workspace. There is no web self-service assignment; the first
# administrator is granted only by the explicit CLI below, which also requires --confirm.
#   QEYNOX_PLATFORM_BOOTSTRAP_ALLOW=true pnpm admin:bootstrap -- \
#     --email operator@example.com --role PLATFORM_ADMIN --confirm --reason "initial operator"
# When the identity account must be created, provide QEYNOX_BOOTSTRAP_PASSWORD (12-256 chars);
# it is read once and never logged or stored in clear text.
QEYNOX_PLATFORM_BOOTSTRAP_ALLOW=false
# Account-lifecycle and notification e-mail transport (verification, recovery, invitations,
# customer notifications: approvals, execution failures, delivered results).
#
# A real adapter IS implemented: Resend (HTTPS API, no SDK dependency). To enable it, set the
# provider name AND its deployment secrets. Until then every e-mail feature fails closed with
# 503 NOT_CONFIGURED and no message is ever claimed to be sent.
#   QEYNOX_EMAIL_PROVIDER=resend
#   QEYNOX_RESEND_API_KEY   Resend API key (secret; never commit a real key)
#   QEYNOX_EMAIL_FROM       RFC 5322 From value, e.g. "QeyNox <notifications@example.com>"
# The Resend API key is read once per process start and is never logged. Delivery outcomes are
# recorded in the email_deliveries ledger; a message is SENT only when the provider accepts it.
QEYNOX_EMAIL_PROVIDER=
QEYNOX_RESEND_API_KEY=
QEYNOX_EMAIL_FROM=

# MISSION A14 — connector hub (workspace external-account connections).
# Server-side credential vault: 32 random bytes, base64-encoded. Without it every connection
# reports NOT_CONFIGURED and no credential material is stored anywhere. Never commit a real key.
#   openssl rand -base64 32
QEYNOX_CONNECTION_CREDENTIAL_KEY=
# Google Workspace is the only reviewed OAuth provider profile. Until an operator provisions all
# three values here, the 'google-workspace' provider truthfully reports NOT_CONFIGURED and no
# connection can be authorized. The redirect URI must be HTTPS (http://localhost is allowed for
# local development only) and must exactly match the registered URI in the Google Cloud console.
QEYNOX_GOOGLE_WORKSPACE_CLIENT_ID=
QEYNOX_GOOGLE_WORKSPACE_CLIENT_SECRET=
QEYNOX_GOOGLE_WORKSPACE_REDIRECT_URI=
# Public base URL of the Web app, used to return the browser after the OAuth callback.
# Optional: when unset the callback answers with a plain-text completion page instead of a redirect.
QEYNOX_PUBLIC_URL=



# MISSION A13 + A16 — operator service catalogue contracts.
# Comma-separated path(s) to operator service bundle JSON files, for example:
#   QEYNOX_SERVICE_CATALOG_PATH=infra/operator/a16-business-packs.json
#   QEYNOX_SERVICE_CATALOG_PATH=infra/operator/packs/01-research.json,infra/operator/packs/04-seo.json
# When unset, published RaaS offers still appear in the catalogue with their real readiness, and
# ordering fails closed with SERVICE_NOT_CONFIGURED.
QEYNOX_SERVICE_CATALOG_PATH=

# Server-only exact origin authorizations, never browser input.
QEYNOX_API_PRIVATE_ORIGIN=
HERMES_PRIVATE_ORIGIN=
QEYNOX_REDIS_URL=

# MISSION A21.01 — HARD PAYMENT FREEZE. Server-authoritative commerce mode.
#   PAYMENTS_DISABLED (default when unset) — no checkout, capture, refund, reconciliation or webhook processing.
#   BETA_FREE — free beta posture; still no financial transaction of any kind and no new entitlement.
# Any other value (including any paid mode) is refused at API boot. Stripe credentials
# (QEYNOX_STRIPE_SECRET_KEY / QEYNOX_STRIPE_WEBHOOK_SECRET) are NOT read while frozen and cannot lift it.
QEYNOX_COMMERCE_MODE=PAYMENTS_DISABLED
